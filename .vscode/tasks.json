        {
            "label": "Build current C++ file with OpenMP",
            "type": "process",
            "command": "C:\\msys64\\mingw64\\bin\\g++.exe",
            "args": [
                "-std=c++17",
                "-O2",
                "-g",
                "-Wall",
                "-Wextra",
                "-fopenmp",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
